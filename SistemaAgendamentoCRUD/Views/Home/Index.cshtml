@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .dashboard-card {
        background-color: #111827;
        border: 1px solid #1f2937;
        border-radius: 16px;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

        .dashboard-card:hover {
            transform: translateY(-4px);
            border-color: #374151;
        }

    .icon-box {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .btn-card-action {
        background-color: #1f2937;
        color: #f9fafb;
        border: 1px solid #374151;
        border-radius: 10px;
        padding: 10px 16px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .btn-card-action:hover {
            background-color: #374151;
            color: #ffffff;
        }
</style>

<div class="container py-4">
    <!-- Header -->
    <div class="mb-5">
        <h2 class="fw-bold text-white mb-1">Painel de Agendamentos</h2>
        <p class="text-secondary m-0">Gerencie seus clientes, serviços prestados e horários marcados em um só lugar.</p>
    </div>

    <!-- Cards de Acesso Rápido -->
    <div class="row g-4 mb-5">
        <!-- Agendamentos -->
        <div class="col-12 col-md-4">
            <div class="dashboard-card p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="icon-box bg-primary bg-opacity-10 text-primary mb-3">
                        <i class="bi bi-calendar-event"></i>
                    </div>
                    <h4 class="fw-bold text-white mb-2">Agendamentos</h4>
                    <p class="text-secondary small mb-4">Gerencie o calendário de horários e compromissos marcados.</p>
                </div>
                <div class="d-flex flex-column gap-2">
                    <a asp-controller="Agendamentos" asp-action="Create" class="btn btn-primary fw-semibold py-2 rounded-3 text-decoration-none">+ Novo Agendamento</a>
                    <a asp-controller="Agendamentos" asp-action="Index" class="btn btn-card-action text-decoration-none text-center">Ver Todos</a>
                </div>
            </div>
        </div>

        <!-- Serviços -->
        <div class="col-12 col-md-4">
            <div class="dashboard-card p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="icon-box bg-warning bg-opacity-10 text-warning mb-3">
                        <i class="bi bi-tools"></i>
                    </div>
                    <h4 class="fw-bold text-white mb-2">Serviços</h4>
                    <p class="text-secondary small mb-4">Cadastre os tipos de serviços oferecidos e seus valores.</p>
                </div>
                <div class="d-flex flex-column gap-2">
                    <a asp-controller="Servicos" asp-action="Create" class="btn btn-warning fw-semibold py-2 rounded-3 text-decoration-none text-dark">+ Novo Serviço</a>
                    <a asp-controller="Servicos" asp-action="Index" class="btn btn-card-action text-decoration-none text-center">Ver Todos</a>
                </div>
            </div>
        </div>

        <!-- Usuários / Clientes -->
        <div class="col-12 col-md-4">
            <div class="dashboard-card p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="icon-box bg-info bg-opacity-10 text-info mb-3">
                        <i class="bi bi-people"></i>
                    </div>
                    <h4 class="fw-bold text-white mb-2">Usuários / Clientes</h4>
                    <p class="text-secondary small mb-4">Cadastre a base de clientes com nomes e contatos.</p>
                </div>
                <div class="d-flex flex-column gap-2">
                    <a asp-controller="Usuarios" asp-action="Create" class="btn btn-info fw-semibold py-2 rounded-3 text-decoration-none text-white">+ Novo Usuário</a>
                    <a asp-controller="Usuarios" asp-action="Index" class="btn btn-card-action text-decoration-none text-center">Ver Todos</a>
                </div>
            </div>
        </div>
    </div>
</div>