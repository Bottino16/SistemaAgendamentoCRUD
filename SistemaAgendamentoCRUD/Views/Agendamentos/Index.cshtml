@model IEnumerable<SistemaAgendamentoCRUD.Models.Agendamento>

@{
    ViewData["Title"] = "Agendamentos";
}

<style>
    .table-card {
        background-color: #111827;
        border: 1px solid #1f2937;
        border-radius: 16px;
        overflow: hidden;
    }

    .table-dark-custom {
        --bs-table-bg: transparent;
        --bs-table-color: #f9fafb;
        color: #f9fafb;
        margin-bottom: 0;
    }

        .table-dark-custom th {
            background-color: #1f2937;
            color: #9ca3af;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border-bottom: 1px solid #374151;
            padding: 16px;
        }

        .table-dark-custom td {
            border-bottom: 1px solid #1f2937;
            padding: 16px;
            vertical-align: middle;
        }

    .btn-action-primary {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        border: none;
        color: white;
        font-weight: 600;
        padding: 10px 20px;
        border-radius: 10px;
    }

    .btn-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background-color: #1f2937;
        border: 1px solid #374151;
        color: #d1d5db;
        transition: all 0.2s ease;
    }

        .btn-icon:hover {
            background-color: #374151;
            color: #ffffff;
        }

    .btn-icon-danger:hover {
        background-color: #7f1d1d;
        border-color: #ef4444;
        color: #fca5a5;
    }
</style>

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold text-white mb-1">Agendamentos Marcados</h3>
            <p class="text-secondary small m-0">Calendário e lista completa de horários reservados.</p>
        </div>
        <a asp-action="Create" class="btn btn-action-primary text-decoration-none">+ Novo Agendamento</a>
    </div>

    <div class="table-card shadow-lg">
        <div class="table-responsive">
            <table class="table table-dark-custom">
                <thead>
                    <tr>
                        <th>Cliente / Usuário</th>
                        <th>Serviço Prestado</th>
                        <th>Data e Horário</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-secondary py-5">
                                <i class="bi bi-calendar-x display-6 d-block mb-2"></i>
                                Nenhum agendamento realizado até o momento.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold text-white">@(item.Usuario?.Nome ?? "Não informado")</td>
                                <td>
                                    <span class="badge bg-secondary bg-opacity-25 text-white fw-normal px-3 py-2 rounded-pill">
                                        @(item.Servico?.Nome ?? "Não informado")
                                    </span>
                                </td>
                                <td class="text-info font-monospace">
                                    <i class="bi bi-clock me-1"></i>@item.DataHora.ToString("dd/MM/yyyy - HH:mm")
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icon text-decoration-none" title="Editar"><i class="bi bi-pencil"></i></a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-icon text-decoration-none" title="Detalhes"><i class="bi bi-eye"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-icon btn-icon-danger text-decoration-none" title="Excluir"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>