@model SistemaAgendamentoCRUD.Models.Agendamento

@{
    ViewData["Title"] = "Editar Agendamento";
}

<style>
    .form-card {
        background-color: #111827;
        border: 1px solid #1f2937;
        border-radius: 16px;
        max-width: 600px;
        margin: 0 auto;
    }

    .form-control-dark, .form-select-dark {
        background-color: #1f2937 !important;
        border: 1px solid #374151 !important;
        color: #f9fafb !important;
        border-radius: 10px;
        padding: 12px 16px;
    }

        .form-control-dark:focus, .form-select-dark:focus {
            border-color: #3b82f6 !important;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.25) !important;
        }

    .form-label-dark {
        color: #d1d5db;
        font-weight: 600;
        font-size: 0.875rem;
        margin-bottom: 8px;
    }

    .btn-action-primary {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        border: none;
        color: white;
        font-weight: 600;
        padding: 12px 24px;
        border-radius: 10px;
        box-shadow: 0 4px 14px rgba(59, 130, 246, 0.4);
    }

    .btn-cancel {
        background-color: #1f2937;
        color: #9ca3af;
        border: 1px solid #374151;
        border-radius: 10px;
        padding: 12px 24px;
        font-weight: 600;
    }
</style>

<div class="form-card p-4 p-md-5 mb-5 shadow-lg">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-secondary small d-inline-flex align-items-center gap-1 mb-2">
            <i class="bi bi-arrow-left"></i> Voltar para a lista
        </a>
        <h3 class="fw-bold text-white mb-1">Editar Agendamento</h3>
        <p class="text-secondary small m-0">Altere os dados do agendamento selecionado.</p>
    </div>

    <form asp-action="Edit">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="UsuarioId" class="form-label form-label-dark">Cliente / Usuário</label>
            <select asp-for="UsuarioId" class="form-select form-select-dark" asp-items="ViewBag.UsuarioId"></select>
            <span asp-validation-for="UsuarioId" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ServicoId" class="form-label form-label-dark">Serviço Prestado</label>
            <select asp-for="ServicoId" class="form-select form-select-dark" asp-items="ViewBag.ServicoId"></select>
            <span asp-validation-for="ServicoId" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="DataHora" class="form-label form-label-dark">Data e Horário</label>
            <input asp-for="DataHora" class="form-control form-control-dark" type="datetime-local" />
            <span asp-validation-for="DataHora" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-end gap-2 pt-3 border-top border-secondary border-opacity-25">
            <a asp-action="Index" class="btn btn-cancel text-decoration-none">Cancelar</a>
            <button type="submit" class="btn btn-action-primary">Salvar Alterações</button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}