@model SistemaAgendamentoCRUD.Models.Servico

@{
    ViewData["Title"] = "Novo Serviço";
}

<style>
    .form-card {
        background-color: #111827;
        border: 1px solid #1f2937;
        border-radius: 16px;
        max-width: 600px;
        margin: 0 auto;
    }

    .form-control-dark {
        background-color: #1f2937 !important;
        border: 1px solid #374151 !important;
        color: #f9fafb !important;
        border-radius: 10px;
        padding: 12px 16px;
    }

        .form-control-dark:focus {
            border-color: #f59e0b !important;
            box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.25) !important;
        }

    .btn-action-warning {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        border: none;
        color: #111827;
        font-weight: 700;
        padding: 12px 24px;
        border-radius: 10px;
    }

    .btn-cancel {
        background-color: #1f2937;
        color: #9ca3af;
        border: 1px solid #374151;
        border-radius: 10px;
        padding: 12px 24px;
        font-weight: 600;
    }
</style>

<div class="form-card p-4 p-md-5 mb-5 shadow-lg">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-secondary small d-inline-flex align-items-center gap-1 mb-2">
            <i class="bi bi-arrow-left"></i> Voltar para a lista
        </a>
        <h3 class="fw-bold text-white mb-1">Cadastrar Serviço</h3>
        <p class="text-secondary small m-0">Informe o nome e o preço do serviço a ser prestado.</p>
    </div>

    <form asp-action="Create">
        <!-- Exibe qualquer erro de validação diretamente na tela se houver -->
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Nome" class="form-label text-secondary fw-semibold small">Nome do Serviço</label>
            <input asp-for="Nome" class="form-control form-control-dark" placeholder="Ex: Cabelo & Barba" />
            <span asp-validation-for="Nome" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Preco" class="form-label text-secondary fw-semibold small">Preço (R$)</label>
            <input asp-for="Preco" class="form-control form-control-dark" type="number" step="0.01" placeholder="0.00" />
            <span asp-validation-for="Preco" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-end gap-2 pt-3 border-top border-secondary border-opacity-25">
            <a asp-action="Index" class="btn btn-cancel text-decoration-none">Cancelar</a>
            <button type="submit" class="btn btn-action-warning">Salvar Serviço</button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}