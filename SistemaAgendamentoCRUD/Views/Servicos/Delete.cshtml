@model SistemaAgendamentoCRUD.Models.Servico

@{
    ViewData["Title"] = "Excluir Serviço";
}

<style>
    .delete-card {
        background-color: #111827;
        border: 1px solid #7f1d1d;
        border-radius: 16px;
        max-width: 600px;
        margin: 0 auto;
    }

    .alert-box {
        background-color: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 12px;
        padding: 16px;
        color: #fca5a5;
    }

    .info-box {
        background-color: #1f2937;
        border: 1px solid #374151;
        border-radius: 12px;
        padding: 16px;
    }

    .btn-action-danger {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        border: none;
        color: white;
        font-weight: 600;
        padding: 10px 20px;
        border-radius: 10px;
    }

    .btn-cancel {
        background-color: #1f2937;
        color: #9ca3af;
        border: 1px solid #374151;
        border-radius: 10px;
        padding: 10px 20px;
        font-weight: 600;
    }
</style>

<div class="delete-card p-4 p-md-5 mb-5 shadow-lg">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-secondary small d-inline-flex align-items-center gap-1 mb-2">
            <i class="bi bi-arrow-left"></i> Voltar para a lista
        </a>
        <h3 class="fw-bold text-danger mb-1">Excluir Serviço</h3>
        <p class="text-secondary small m-0">Esta ação não poderá ser desfeita.</p>
    </div>

    <div class="alert-box mb-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> Tem certeza de que deseja remover este serviço?
    </div>

    <div class="d-flex flex-column gap-3 mb-4">
        <div class="info-box">
            <span class="text-secondary small d-block mb-1">Nome do Serviço</span>
            <span class="fs-5 fw-bold text-white">@Model.Nome</span>
        </div>

        <div class="info-box">
            <span class="text-secondary small d-block mb-1">Preço</span>
            <span class="fs-5 fw-bold text-warning">@Model.Preco.ToString("C")</span>
        </div>
    </div>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex justify-content-end gap-2 pt-3 border-top border-secondary border-opacity-25">
            <a asp-action="Index" class="btn btn-cancel text-decoration-none">Cancelar</a>
            <button type="submit" class="btn btn-action-danger">Confirmar Exclusão</button>
        </div>
    </form>
</div>