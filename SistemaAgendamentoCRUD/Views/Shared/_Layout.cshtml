<!DOCTYPE html>
<html lang="pt-br" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Agendamentos</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        body {
            background-color: #0b0f19;
            color: #f9fafb;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }

        .navbar-custom {
            background-color: #111827;
            border-bottom: 1px solid #1f2937;
        }

        .navbar-brand-badge {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: white;
        }

        .nav-link-custom {
            color: #9ca3af !important;
            font-weight: 500;
            padding: 8px 16px !important;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

            .nav-link-custom:hover {
                color: #ffffff !important;
                background-color: #1f2937;
            }

            .nav-link-custom.active {
                color: #ffffff !important;
                background-color: #1f2937;
            }

        footer {
            background-color: #111827;
            border-top: 1px solid #1f2937;
        }
    </style>
</head>
<body class="d-flex flex-column h-100">
    <header>
        <nav class="navbar navbar-expand-md navbar-custom py-3">
            <div class="container">
                <a class="navbar-brand text-white fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="navbar-brand-badge"><i class="bi bi-calendar-check-fill"></i></span>
                    <span class="fs-6">Sistemas de agendamentos feito por felipe bottino</span>
                </a>
                <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <i class="bi bi-list fs-3"></i>
                </button>
                <div class="collapse navbar-collapse justify-content-end mt-3 mt-md-0" id="navbarContent">
                    <ul class="navbar-nav gap-1">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-grid-1x2"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom d-flex align-items-center gap-2" asp-controller="Agendamentos" asp-action="Index">
                                <i class="bi bi-calendar-event"></i> Agendamentos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom d-flex align-items-center gap-2" asp-controller="Servicos" asp-action="Index">
                                <i class="bi bi-gear"></i> Serviços
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom d-flex align-items-center gap-2" asp-controller="Usuarios" asp-action="Index">
                                <i class="bi bi-people"></i> Usuários
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-shrink-0 my-auto py-4">
        @RenderBody()
    </main>

    <footer class="mt-auto py-3 text-center text-secondary small">
        <div class="container">
            &copy; @DateTime.Now.Year — <strong>Sistemas de agendamentos feito por felipe bottino</strong> | Todos os direitos reservados.
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>