@model SistemaAgendamentoCRUD.Models.Servico

@{
    ViewData["Title"] = "Detalhes do Serviço";
}

<style>
    .details-card {
        background-color: #111827;
        border: 1px solid #1f2937;
        border-radius: 16px;
        max-width: 600px;
        margin: 0 auto;
    }

    .info-box {
        background-color: #1f2937;
        border: 1px solid #374151;
        border-radius: 12px;
        padding: 16px;
    }

    .btn-action-warning {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        border: none;
        color: #111827;
        font-weight: 700;
        padding: 10px 20px;
        border-radius: 10px;
    }

    .btn-cancel {
        background-color: #1f2937;
        color: #9ca3af;
        border: 1px solid #374151;
        border-radius: 10px;
        padding: 10px 20px;
        font-weight: 600;
    }
</style>

<div class="details-card p-4 p-md-5 mb-5 shadow-lg">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-secondary small d-inline-flex align-items-center gap-1 mb-2">
            <i class="bi bi-arrow-left"></i> Voltar para a lista
        </a>
        <h3 class="fw-bold text-white mb-1">Detalhes do Serviço</h3>
        <p class="text-secondary small m-0">Informações sobre a modalidade de atendimento.</p>
    </div>

    <div class="d-flex flex-column gap-3 mb-4">
        <div class="info-box">
            <span class="text-secondary small d-block mb-1">Nome do Serviço</span>
            <span class="fs-5 fw-bold text-white">@Model.Nome</span>
        </div>

        <div class="info-box">
            <span class="text-secondary small d-block mb-1">Preço / Valor</span>
            <span class="fs-4 fw-bold text-warning">@Model.Preco.ToString("C")</span>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 pt-3 border-top border-secondary border-opacity-25">
        <a asp-action="Index" class="btn btn-cancel text-decoration-none">Voltar</a>
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-action-warning text-decoration-none">Editar Serviço</a>
    </div>
</div>