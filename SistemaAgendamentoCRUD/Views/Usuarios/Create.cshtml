@model SistemaAgendamentoCRUD.Models.Usuario

@{
    ViewData["Title"] = "Novo Usuário";
}

<style>
    .form-card {
        background-color: #111827;
        border: 1px solid #1f2937;
        border-radius: 16px;
        max-width: 600px;
        margin: 0 auto;
    }

    .form-control-dark {
        background-color: #1f2937 !important;
        border: 1px solid #374151 !important;
        color: #f9fafb !important;
        border-radius: 10px;
        padding: 12px 16px;
    }

        .form-control-dark:focus {
            border-color: #06b6d4 !important;
            box-shadow: 0 0 0 4px rgba(6, 182, 212, 0.25) !important;
        }

    .btn-action-info {
        background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
        border: none;
        color: white;
        font-weight: 600;
        padding: 12px 24px;
        border-radius: 10px;
    }

    .btn-cancel {
        background-color: #1f2937;
        color: #9ca3af;
        border: 1px solid #374151;
        border-radius: 10px;
        padding: 12px 24px;
        font-weight: 600;
    }
</style>

<div class="form-card p-4 p-md-5 mb-5 shadow-lg">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-secondary small d-inline-flex align-items-center gap-1 mb-2">
            <i class="bi bi-arrow-left"></i> Voltar para a lista
        </a>
        <h3 class="fw-bold text-white mb-1">Cadastrar Usuário</h3>
        <p class="text-secondary small m-0">Preencha os dados de contato do novo cliente.</p>
    </div>

    <form asp-action="Create">
        <!-- 'All' mostra qualquer erro de validação do Model diretamente no topo do form -->
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Nome" class="form-label text-secondary fw-semibold small">Nome Completo</label>
            <input asp-for="Nome" class="form-control form-control-dark" placeholder="Ex: Felipe Bottino" />
            <span asp-validation-for="Nome" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Telefone" class="form-label text-secondary fw-semibold small">Telefone / WhatsApp</label>
            <input asp-for="Telefone" class="form-control form-control-dark" placeholder="(11) 99999-9999" />
            <span asp-validation-for="Telefone" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-end gap-2 pt-3 border-top border-secondary border-opacity-25">
            <a asp-action="Index" class="btn btn-cancel text-decoration-none">Cancelar</a>
            <button type="submit" class="btn btn-action-info">Salvar Usuário</button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}